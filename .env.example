# Patylook (PHP) configuration. Copy to .env for local use; on the server prefer real environment
# variables (hosting panel). Real environment variables always override values in this file.
# Comments must be on their own line (not after a value).

# development | production
APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo
# Idle session lifetime (e.g. 30m, 8h)
SESSION_TTL=8h
# Defaults to true when APP_ENV=production. Keep false for plain http on localhost.
# COOKIE_SECURE=true

# =====================================================================================
# ATENÇÃO - CREDENCIAIS DO BANCO DE DADOS
# Os valores abaixo são APENAS para o ambiente LOCAL (localhost / root / sem senha).
# ANTES de subir para produção (HostGator), ALTERE DB_HOST, DB_USER, DB_PASSWORD e
# DB_NAME para as credenciais do MySQL do servidor, defina APP_ENV=production e
# NUNCA use o usuário root sem senha fora da máquina local.
# Em produção, prefira variáveis de ambiente do servidor a um arquivo .env.
# =====================================================================================
# Existing MySQL database (local) - the same one the Go version uses
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# On shared hosting the name is usually prefixed, e.g. cpaneluser_patylook
DB_NAME=patylook
# true | skip-verify | preferred, when the server requires TLS
# DB_TLS=

# user_category name that grants administrative permissions (user management)
ADMIN_CATEGORY=admin

# Directory with one folder per product (images/products/<SKU>/principal.jpg, ...).
# Relative paths are resolved from the project root. Keep it outside any deploy step that
# wipes files, and back it up together with the database.
IMAGES_DIR=images/products

# Directory for sessions, login throttling, logs and caches (must be writable by PHP). Relative
# paths are resolved from the project root. Never place it inside the public/ folder.
# STORAGE_DIR=storage

# Optional first-run bootstrap: only used when the `user` table is completely empty.
# Remove these after the first start.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_NAME=Administrador
# BOOTSTRAP_ADMIN_PASSWORD=
